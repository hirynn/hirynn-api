model Report {
    id                    String  @id @default(cuid())
    reporterTeacherId     String?
    reporterSchoolAdminId String?
    reporterType          String  @map("reporter_type") @db.VarChar(20) // "TEACHER" or "SCHOOL_ADMIN"
    reportedTeacherId     String?
    reportedSchoolAdminId String?

    reportedUserType  String?      @map("reported_user_type") @db.VarChar(20) // "TEACHER" or "SCHOOL_ADMIN"
    reportedContentId String?      @map("reported_content_id")
    contentType       String?      @map("content_type") @db.VarChar(50)
    reason            String       @db.VarChar(200)
    description       String?      @db.Text
    status            ReportStatus @default(PENDING)
    handledBy         String?      @map("handled_by") // Admin who handled the report
    createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
    resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz

    // Relations - polymorphic based on reporter/reported types
    reporterTeacher     Teacher?     @relation("ReporterRelation", fields: [reporterTeacherId], references: [id], onDelete: Cascade, map: "reports_reporter_teacher_fkey")
    reporterSchoolAdmin SchoolAdmin? @relation("SchoolAdminReporterRelation", fields: [reporterSchoolAdminId], references: [id], onDelete: Cascade, map: "reports_reporter_school_admin_fkey")
    reportedTeacher     Teacher?     @relation("ReportedTeacherRelation", fields: [reportedTeacherId], references: [id], onDelete: SetNull, map: "reports_reported_teacher_fkey")
    reportedSchoolAdmin SchoolAdmin? @relation("ReportedSchoolAdminRelation", fields: [reportedSchoolAdminId], references: [id], onDelete: SetNull, map: "reports_reported_school_admin_fkey")
    handler             Admin?       @relation("AdminHandlerRelation", fields: [handledBy], references: [id], onDelete: SetNull)

    // Indexes for admin queries
    @@index([reporterTeacherId])
    @@index([reporterSchoolAdminId])
    @@index([reporterType])
    @@index([reportedSchoolAdminId])
    @@index([reportedUserType])
    @@index([contentType])
    @@index([status])
    @@index([handledBy])
    @@index([createdAt])
    @@map("reports")
}
