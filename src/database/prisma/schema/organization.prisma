model JobOrganization {
  id               String          @id @default(uuid())
  title            String
  description      String
  location         String?
  organizationName String
  employmentType   EmploymentType? // e.g.,   FULL_TIME // PART_TIME  //CONTRACT
  organizationId   String // comes from frontend form (hardcoded or selected)
  createdByName    String? // Name or email of creator (from frontend)
  isActive         Boolean         @default(true)
  slug             String          @unique // public-facing URL identifier

  applications OrganizationApplication[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model OrganizationApplication {
  id                String            @id @default(uuid())
  jobId             String
  job               JobOrganization   @relation(fields: [jobId], references: [id])
  fullName          String
  email             String
  phoneNumber       String?
  currentCompany    String?
  yearsOfExperience Int?
  location          String?
  linkedinUrl       String?
  portfolioLink     String?
  resumeUrl         String? // URL to resume file
  coverLetter       String? // optional
  status            ApplicationStatus @default(SUBMITTED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
