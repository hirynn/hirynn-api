// School Admin model - standalone without User model
model SchoolAdmin {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(255)
  password     String?  @db.VarChar(255)
  googleId     String?  @unique @map("google_id")
  linkedinId   String?  @unique @map("linkedIn_id")
  name         String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  isVerified   Boolean  @default(false) @map("is_verified")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  refreshToken String?
  resetToken   String?

  // Relations
  organizations   Organization[]
  notifications   Notification[]
  reportsReporter Report[]       @relation("SchoolAdminReporterRelation")
  reportsReported Report[]       @relation("ReportedSchoolAdminRelation")

  // Indexes
  @@index([email])
  @@index([googleId])
  @@index([isActive])
  @@index([createdAt])
  @@map("school_admins")
}

model JobPoster {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  email          String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("job_posters")
}

model Organization {
  id           String      @id @default(cuid())
  teacherId    String      @map("teacherId")
  // schoolAdminId String?   @map("school_admin_id")
  type         SchoolType  @default(PUBLIC)
  description  String?     @db.Text
  name         String      @db.VarChar(200)
  logoUrl      String?     @map("logo_url") @db.VarChar(500)
  bannerUrl    String?     @map("banner_url") @db.VarChar(500)
  about        String?     @db.Text
  vision       String?     @db.Text
  address      String?     @db.VarChar(500)
  phone        String?     @db.VarChar(20)
  website      String?     @db.VarChar(200)
  contactEmail String?     @map("contact_email") @db.VarChar(255)
  isVerified   Boolean     @default(false) @map("is_verified")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  jobPosters   JobPoster[]

  // Relations
  // schoolAdmin SchoolAdmin? @relation(fields: [schoolAdminId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  jobs    Job[]
  posts   Post[]

  cvSubmissions CVSubmission[]

  // schoolAdminId String?
  schoolAdmin   SchoolAdmin? @relation(fields: [schoolAdminId], references: [id])
  schoolAdminId String?

  // Betterschool Directory link — set once a directory school admin approves
  // a DirectoryConnectionRequest for this organization.
  directorySchoolId String? @unique @map("directory_school_id")

  // Indexes
  //@@index([teacherId])
  @@index([teacherId])
  @@index([name])
  @@index([isVerified])
  @@index([createdAt])
  @@map("organizations")
}

// A short-lived handshake between a Betterschool Directory school (already
// authenticated in its own dashboard) and a Hirynn organization the signed-in
// Hirynn school admin manages. Mirrors an OAuth device-code flow: the
// directory backend mints a `code` server-to-server, sends its admin to the
// Hirynn dashboard to approve it there, and polls this record for the outcome.
model DirectoryConnectionRequest {
  id                    String    @id @default(cuid())
  code                  String    @unique
  // The DirectorySchool _id (Mongo ObjectId, stored as string).
  directorySchoolId     String    @map("directory_school_id")
  // Cached only for display on Hirynn's "authorize connection" screen.
  directorySchoolName   String?   @map("directory_school_name")
  directorySchoolLogo   String?   @map("directory_school_logo")
  requestedByName       String?   @map("requested_by_name")
  requestedByEmail      String?   @map("requested_by_email")
  status                String    @default("pending") // pending | approved | expired
  // Set once approved.
  organizationId        String?   @map("organization_id")
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([directorySchoolId])
  @@index([status])
  @@map("directory_connection_requests")
}
